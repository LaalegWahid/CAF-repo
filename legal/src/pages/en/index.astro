---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE } from "../../consts";
import { SITE_EN, STATS_EN as STATS, SERVICES_EN as SERVICES, GUIDES_EN as GUIDES, FAQ_EN as FAQ } from "../../consts.en";

const pageTitle = `${SITE_EN.tagline} · ${SITE.name}`;
const addr = SITE.address;
const pageUrl = `${SITE.url}/en/`;
const orgId = `${SITE.url}/#organization`;

/* ---------- Structured data (JSON-LD) ---------- */
const organization = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  "@id": orgId,
  name: SITE_EN.legalName,
  alternateName: SITE.name,
  url: pageUrl,
  logo: `${SITE.url}/Logo_128x128.png`,
  image: `${SITE.url}/Logo_128x128.png`,
  description: SITE_EN.description,
  email: SITE.email,
  telephone: SITE.phoneE164,
  priceRange: "$$$",
  knowsLanguage: ["en", "fr", "ar"],
  areaServed: { "@type": "Country", name: "Morocco" },
  address: {
    "@type": "PostalAddress",
    streetAddress: addr.street,
    addressLocality: addr.locality,
    addressRegion: addr.region,
    postalCode: addr.postalCode,
    addressCountry: addr.country,
  },
  parentOrganization: {
    "@type": "Organization",
    name: "CAF — Expertise sociale & Audit",
    url: "https://www.cabinet-caf.ma",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Audit services",
    itemListElement: [
      ...SERVICES.map((s) => ({
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: s.title, url: `${pageUrl}#services` },
      })),
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Business valuation, sale & acquisition",
          url: `${pageUrl}#valuation`,
        },
      },
    ],
  },
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${pageUrl}#website`,
  url: pageUrl,
  name: `${SITE.name} — Audit`,
  inLanguage: "en",
  publisher: { "@id": orgId },
};

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const jsonLd = [organization, website, faqPage];

const serviceIcons: Record<number, string> = {
  18: `<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/><path d="m9 15 2 2 4-4"/>`,
  14: `<path d="M12 3 4 6v6c0 5 3.4 7.7 8 9 4.6-1.3 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>`,
  16: `<path d="m12 2 9 5-9 5-9-5z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>`,
  17: `<path d="M4.5 19a9 9 0 1 1 15 0"/><path d="M12 13V7"/><circle cx="12" cy="13" r="1.4"/>`,
};

const steps = [
  {
    t: "Understanding the business & engagement letter",
    d: "We learn your activity, environment and internal controls, and agree the scope and terms of the engagement, including group reporting deadlines.",
  },
  {
    t: "Planning & risk assessment",
    d: "Identifying risks of material misstatement, setting materiality and designing an audit strategy suited to the entity.",
  },
  {
    t: "Fieldwork: interim & final",
    d: "Testing controls and transactions during the year, then auditing the accounts after the year-end.",
  },
  {
    t: "Completion, opinion & reports",
    d: "Independent review of conclusions, communication with those charged with governance, general and special reports, and a summary in English for head office.",
  },
];
---

<Layout
  title={pageTitle}
  description={SITE_EN.description}
  path="/en/"
  lang="en"
  alternates={{ fr: "/", en: "/en/" }}
  jsonLd={jsonLd}
>
  <Header lang="en" switchTo="/" />

  <main id="main">
    <!-- ================= HERO ================= -->
    <section class="hero" id="top">
      <div class="container hero__inner">
        <div class="hero__body">
          <p class="eyebrow">Audit &amp; assurance — Morocco</p>
          <h1>Audit your Moroccan subsidiary to group standards</h1>
          <p class="lead">
            CAF’s audit team in Casablanca works for UK and US groups with
            operations in Morocco: statutory audit, group reporting packages,
            internal audit, consolidation and performance audit, under ISA and
            Moroccan standards and reported in English.
          </p>
          <div class="hero__cta">
            <a class="btn btn--primary" href="#contact">Request a proposal</a>
            <a class="btn btn--ghost" href="#services">See our audits</a>
          </div>
          <ul class="hero__trust">
            <li><strong>ISA</strong> &amp; Moroccan standards</li>
            <li><strong>Standardised</strong> audit file</li>
            <li><strong>Independence</strong> and quality review</li>
          </ul>
        </div>

        <div class="hero__media">
          <div class="hero__viz">
            <svg viewBox="0 0 420 380" role="img" aria-label="Certified audit report: a document with a certification seal">
              <rect x="52" y="34" width="212" height="278" rx="6" fill="#f8f8fc" stroke="#e4e5ef" />
              <rect x="78" y="66" width="132" height="12" rx="3" fill="#b3b3ea" />
              <rect x="78" y="92" width="160" height="8" rx="3" fill="#eeeefb" />
              <rect x="78" y="110" width="120" height="8" rx="3" fill="#eeeefb" />
              <rect x="78" y="146" width="160" height="8" rx="3" fill="#eeeefb" />
              <rect x="78" y="164" width="150" height="8" rx="3" fill="#eeeefb" />
              <rect x="78" y="182" width="160" height="8" rx="3" fill="#eeeefb" />
              <rect x="78" y="200" width="96" height="8" rx="3" fill="#eeeefb" />

              <g transform="translate(288 250)">
                <g fill="#4747b3">
                  <rect x="60" y="-6" width="12" height="12" transform="rotate(45 66 0)" />
                  <rect x="41" y="41" width="12" height="12" transform="rotate(45 47 47)" />
                  <rect x="-6" y="60" width="12" height="12" transform="rotate(45 0 66)" />
                  <rect x="-53" y="41" width="12" height="12" transform="rotate(45 -47 47)" />
                  <rect x="-72" y="-6" width="12" height="12" transform="rotate(45 -66 0)" />
                  <rect x="-53" y="-53" width="12" height="12" transform="rotate(45 -47 -47)" />
                  <rect x="-6" y="-72" width="12" height="12" transform="rotate(45 0 -66)" />
                  <rect x="41" y="-53" width="12" height="12" transform="rotate(45 47 -47)" />
                </g>
                <path d="M-14 46 l-9 44 l18 -11 l14 18 l7 -46 z" fill="#393996" />
                <circle r="52" fill="#4747b3" />
                <circle r="44" fill="none" stroke="#ffffff" stroke-opacity="0.45" stroke-width="2" />
                <path d="M-21 2 l13 14 l28 -32" fill="none" stroke="#ffffff" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
              </g>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= KEY FIGURES ================= -->
    <section class="section stats" aria-label="The audit team in figures">
      <div class="container stats__grid">
        {
          STATS.map((s) => (
            <div class="stats__item">
              <span class="stats__value">{s.value}</span>
              <span class="stats__label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================= SERVICES ================= -->
    <section class="section section--alt" id="services">
      <div class="container">
        <div class="section__head">
          <p class="eyebrow">Our services</p>
          <h2>Four types of audit under one roof</h2>
          <p class="lead">
            From the local statutory audit to the reporting package your group
            auditors need, every engagement follows a standard audit file and an
            independent review of conclusions.
          </p>
        </div>
        <div class="grid grid--2">
          {
            SERVICES.map((s) => (
              <article class="card">
                <span class="card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={serviceIcons[s.id]} />
                </span>
                <h3>
                  <a class="stretched" href="#contact">{s.title}</a>
                </h3>
                <p>{s.desc}</p>
                <span class="card__link">Discuss your audit &rarr;</span>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= METHOD ================= -->
    <section class="section" id="method">
      <div class="container">
        <div class="section__head">
          <p class="eyebrow">Our method</p>
          <h2>An audit engagement in four stages</h2>
        </div>
        <div class="grid grid--4 steps">
          {
            steps.map((s) => (
              <article class="card step">
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= RESOURCES ================= -->
    <section class="section section--alt" id="resources">
      <div class="container">
        <div class="section__head">
          <p class="eyebrow">Resources</p>
          <h2>Auditing in Morocco: the essentials</h2>
          <p class="lead">
            Practical guidance on obligations, how engagements run and the
            standards that apply in Morocco.
          </p>
        </div>
        <div class="grid grid--3">
          {
            GUIDES.map((g) => (
              <article class="card guide">
                <h3>{g.title}</h3>
                <p>{g.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= VALUATION, SALE & ACQUISITION ================= -->
    <section class="section" id="valuation">
      <div class="container">
        <div class="panel-dark">
          <div class="panel-dark__body">
            <p class="eyebrow">06 — Valuation &amp; acquisitions</p>
            <h2>Business valuation, sale &amp; acquisition</h2>
            <p>
              For buyers, sellers and investors who need to answer a simple
              question: what is this Moroccan business worth, and what will it
              reveal before a deal? We carry out multi-method valuations and
              acquisition due diligence, fully independent of our statutory
              audit engagements.
            </p>
            <ul>
              <li>UK and US buyers preparing an acquisition or a stake</li>
              <li>Sellers who want an objective view of their price</li>
              <li>Investors and funds running due diligence</li>
            </ul>
            <div class="hero__cta">
              <a class="btn btn--light" href="#contact">Get a valuation</a>
              <a class="btn btn--outline-light" href="#contact">Start a due diligence</a>
            </div>
          </div>
          <aside class="panel-dark__aside">
            <h3>Methods &amp; deliverables</h3>
            <p>
              DCF, market multiples and adjusted net asset valuation · financial,
              tax and employment review of the target · risk summary · support
              negotiating the seller’s warranties.
            </p>
            <a href="https://corporate.cabinet-caf.ma/en/">See our corporate finance team &rarr;</a>
          </aside>
        </div>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section class="section section--alt" id="faq">
      <div class="container">
        <div class="section__head section__head--center">
          <p class="eyebrow">FAQ</p>
          <h2>What finance directors and boards ask us</h2>
        </div>
        <div class="faq">
          {
            FAQ.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <div class="faq__body">{f.a}</div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= CONTACT / CTA ================= -->
    <section class="section" id="contact">
      <div class="container cta-band">
        <p class="eyebrow">Contact</p>
        <h2>Let’s talk about your audit</h2>
        <p class="lead" style="margin-inline:auto;max-width:52ch">
          Statutory audit, group reporting, internal audit, consolidation or
          valuation: tell us what you need. We reply within one business day
          with a proposal.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={`mailto:${SITE.email}`}>Email the audit team</a>
          <a class="btn btn--ghost" href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
