---
import { SITE } from "../consts";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — accueil`}>
      <img src="/Logo_128x128.png" alt="" width="34" height="34" />
      <span>
        {SITE.name}
        <small>Expertise sociale &amp; audit</small>
      </span>
    </a>

    <div class="nav-wrap">
      <input type="checkbox" id="nav-toggle" class="nav-cb" hidden />
      <label class="nav-burger" for="nav-toggle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span>Menu</span>
      </label>

      <nav class="nav" aria-label="Navigation principale">
        <a href="/#services">Services</a>
        <a href="/#ressources">Ressources</a>
        <a href="/#audit-legal">Audit légal</a>
        <a href="/#faq">FAQ</a>
        <a class="btn btn--primary" href="/#contact">Demander un devis</a>
      </nav>
    </div>
  </div>
</header>
