---
import { SITE } from "../consts";

interface Props {
  lang?: "fr" | "en";
  /** Path of this page in the other language, for the switcher. */
  switchTo?: string;
}
const { lang = "fr", switchTo } = Astro.props;
const en = lang === "en";
const home = en ? "/en/" : "/";
const otherLang = en ? "fr" : "en";
const otherHref = switchTo ?? (en ? "/" : "/en/");
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={home} aria-label={`${SITE.name} — ${en ? "home" : "accueil"}`}>
      <img src="/Logo_128x128.png" alt="" width="34" height="34" />
      <span>
        {SITE.name}
        <small>{en ? "Payroll, HR &amp; audit" : "Expertise sociale &amp; audit"}</small>
      </span>
    </a>

    <div class="nav-wrap">
      <input type="checkbox" id="nav-toggle" class="nav-cb" hidden />
      <label class="nav-burger" for="nav-toggle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span>Menu</span>
      </label>

      {
        en ? (
          <nav class="nav" aria-label="Main navigation">
            <a href="/en/#services">Services</a>
            <a href="/en/#resources">Resources</a>
            <a href="/en/#statutory-audit">Statutory audit</a>
            <a href="/en/#faq">FAQ</a>
            <a href={otherHref} hreflang={otherLang} lang={otherLang} aria-label="Lire ce site en français">FR</a>
            <a class="btn btn--primary" href="/en/#contact">Get a quote</a>
          </nav>
        ) : (
          <nav class="nav" aria-label="Navigation principale">
            <a href="/#services">Services</a>
            <a href="/#ressources">Ressources</a>
            <a href="/#audit-legal">Audit légal</a>
            <a href="/#faq">FAQ</a>
            <a href={otherHref} hreflang={otherLang} lang={otherLang} aria-label="Read this site in English">EN</a>
            <a class="btn btn--primary" href="/#contact">Demander un devis</a>
          </nav>
        )
      }
    </div>
  </div>
</header>
