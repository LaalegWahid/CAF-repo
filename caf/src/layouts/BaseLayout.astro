---
import '@fontsource-variable/work-sans';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';
import { SITE } from '../consts';
import Schema from '../components/Schema.astro';
import { langFromUrl, alternatesFor, ui } from '../i18n';

interface QA {
  q: string;
  a: string;
}
interface Props {
  title?: string;
  description?: string;
  path?: string;
  pageType?: 'hub' | 'service';
  faqs?: QA[];
  breadcrumb?: { name: string; item?: string }[];
}

const lang = langFromUrl(Astro.url);
const t = ui(lang);

const {
  title,
  description = t.description,
  path = '/',
  pageType = 'hub',
  faqs,
  breadcrumb,
} = Astro.props;
const site = Astro.site ?? new URL(SITE.url);

const pageTitle = title ? `${title} | ${SITE.name}` : `${t.tagline} | ${SITE.name}`;
const canonical = new URL(path, site).href;
const alt = alternatesFor(path);
const hreflangs: [string, string][] = [];
if (alt.fr) hreflangs.push(['fr', new URL(alt.fr, site).href]);
if (alt.en) hreflangs.push(['en', new URL(alt.en, site).href]);
const xDefault = new URL(alt.fr ?? alt.en ?? path, site).href;
const ogImage = new URL(SITE.ogImage, site).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content={SITE.name} />

    {hreflangs.map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${t.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0E3A5B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <script is:inline>
      /* marque le JS actif avant le rendu : les animations ne cachent rien sans JS */
      document.documentElement.classList.add('js');
    </script>

    <Schema
      path={path}
      name={title}
      description={description}
      pageType={pageType}
      faqs={faqs}
      breadcrumb={breadcrumb}
    />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />

    <script>
      // État "scrolled" du header — minuscule, sans dépendance.
      const header = document.querySelector('[data-header]');
      if (header) {
        const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
        onScroll();
        addEventListener('scroll', onScroll, { passive: true });
      }

      // Révélation au défilement.
      const reveals = document.querySelectorAll('[data-reveal]');
      const revealAll = () => reveals.forEach((el) => el.classList.add('is-visible'));
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        reveals.forEach((el) => io.observe(el));
        // filet de sécurité : onglet en arrière-plan / IO muet → on montre tout
        setTimeout(() => {
          if (![...reveals].some((el) => el.classList.contains('is-visible'))) revealAll();
        }, 1600);
      }
    </script>
  </body>
</html>
