---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import NumberedList from '../../components/NumberedList.astro';
import DefList from '../../components/DefList.astro';
import Faq from '../../components/Faq.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import Contact from '../../components/Contact.astro';

const title = 'Corporate law & company secretarial services in Morocco';
const description =
  'Annual general meetings, minutes, capital changes, share transfers, conversions and dissolutions. CAF Management keeps your Moroccan subsidiary’s legal records up to date.';

const interventions = [
  {
    title: 'Annual company secretarial work',
    body: 'Notice and holding of the annual meeting to approve the accounts, management report, minutes, court registry filings and legal notices, on time.',
  },
  {
    title: 'Capital changes',
    body: 'Capital increases in cash, in kind or by capitalising reserves; capital reductions; reduce-and-increase operations to absorb losses.',
  },
  {
    title: 'Share transfers',
    body: 'Transfer agreement, approval procedure, registration, and updates to the registers and articles.',
  },
  {
    title: 'Conversions',
    body: 'Conversion from SARL to SA and vice versa, with the conversion auditor where the law requires one.',
  },
  {
    title: 'Amendments to the articles',
    body: 'Change of registered office, company name, corporate purpose, manager or chair, or extension of the company’s term.',
  },
  {
    title: 'Dissolution & solvent liquidation',
    body: 'Dissolution decision, appointment of the liquidator, liquidation accounts and removal from the Trade Register.',
  },
];

const why = [
  {
    title: 'Legal certainty',
    body: 'Decisions taken and published in the proper form, which avoids void resolutions, penalties and shareholder challenges.',
  },
  {
    title: 'Registers kept current',
    body: 'Share register, minute book and registry filings maintained continuously, not rebuilt in a rush.',
  },
  {
    title: 'Ready for audit or due diligence',
    body: 'Clean legal records speed up group audits, financing requests and the arrival of an investor or buyer.',
  },
  {
    title: 'Less work for head office',
    body: 'We track every deadline from Casablanca. You approve and sign remotely; we file.',
  },
];

const faqs = [
  {
    q: 'Is an annual general meeting mandatory in Morocco?',
    a: 'Yes. Commercial companies must hold a meeting to approve the accounts within six months of the year-end, decide on the allocation of profit and, where relevant, deal with equity falling below a quarter of the share capital.',
  },
  {
    q: 'Can a foreign parent company sign resolutions remotely?',
    a: 'Yes. For a subsidiary with a UK or US shareholder, we prepare the resolutions and, where needed, the powers of attorney for remote signature. Some documents signed abroad need an apostille; we tell you which ones in advance.',
  },
  {
    q: 'What if filings have been missed for several years?',
    a: 'We regularise the position: we reconstruct missing meetings, minutes, registry filings and notices. It is better done before a tax audit, a sale or a loan application.',
  },
  {
    q: 'Do you handle share transfers between group companies?',
    a: 'Yes: draft and final transfer agreement, approval procedure under the articles, registration with the tax authorities and updates to the registers and articles.',
  },
  {
    q: 'Do you work on a one-off basis or on an annual retainer?',
    a: 'Both. Many clients choose an annual company secretarial package covering the accounts meeting and one or two changes; larger transactions are quoted separately.',
  },
];
---

<BaseLayout
  path="/en/corporate-secretarial"
  title={title}
  description={description}
  pageType="service"
  faqs={faqs}
>
  <Header />
  <main id="main">
    <PageHero
      eyebrow="Corporate law"
      title="Your Moroccan company’s legal life, kept up to date all year"
      lede="Meetings, minutes, capital changes, share transfers and conversions: we run company secretarial work for your Moroccan entity and make sure every decision is properly documented."
    />

    <Section index="01" eyebrow="What we do" title="What we take care of">
      <NumberedList items={interventions} />
    </Section>

    <Section index="02" eyebrow="Why outsource it" title="The value of a local company secretary" variant="tint">
      <DefList items={why} />
    </Section>

    <Faq faqs={faqs} title="Corporate law: common questions" />
    <RelatedServices current="/en/corporate-secretarial" />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
