---
import { ORG, SITE } from '../consts';
import { langFromUrl, navFor, ui } from '../i18n';
import Particles from './Particles.astro';
const lang = langFromUrl(Astro.url);
const t = ui(lang).footer;
const NAV = navFor(lang);
const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="ft-particles"><Particles variant="ambient" /></div>
  <div class="wrap grid">
    <div class="col about">
      <div class="brand">
        <img src="/logo.svg" width="52" height="40" alt="" />
        <span>CAF Management</span>
      </div>
      <p>
        {t.about(ORG.foundingYear)}
      </p>
      <div class="social">
        <a href={ORG.linkedin} rel="noopener" target="_blank">LinkedIn</a>
        <a href={ORG.facebook} rel="noopener" target="_blank">Facebook</a>
      </div>
    </div>

    <nav class="col" aria-label={t.onSite}>
      <h2>{t.expertise}</h2>
      <ul>
        {NAV.filter((i) => i.href !== '/' && i.href !== '/en/').map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        <li><a href="#contact">{t.contact}</a></li>
      </ul>
    </nav>

    <nav class="col" aria-label={t.firm}>
      <h2>{t.firm}</h2>
      <ul>
        <li><a href={ORG.parentSite} rel="noopener" target="_blank">{t.mainSite}</a></li>
        <li><a href={`${ORG.parentSite}/services/`} rel="noopener" target="_blank">{t.services}</a></li>
        <li><a href={`${ORG.parentSite}/qui-sommes-nous/`} rel="noopener" target="_blank">{t.about2}</a></li>
        <li><a href={`${ORG.parentSite}/blog/`} rel="noopener" target="_blank">{t.blog}</a></li>
      </ul>
    </nav>

    <div class="col">
      <h2>{t.contact}</h2>
      <address>
        <a href={ORG.mapsUrl} rel="noopener" target="_blank">
          {ORG.street}<br />{ORG.locality} — {ORG.postalCode}, {ui(lang).country}
        </a>
        <a href={`tel:${ORG.phone}`}>{ORG.phoneDisplay}</a>
        <a href={`mailto:${ORG.email}`}>{ORG.email}</a>
      </address>
    </div>
  </div>

  <div class="wrap legal">
    <p>© {year} {SITE.name}. {t.rights(SITE.name)}</p>
    <p>
      <a href={`${ORG.parentSite}/conditions-generales/`} rel="noopener" target="_blank">{t.terms}</a>
      <span aria-hidden="true">·</span>
      <a href={`${ORG.parentSite}/politique-de-confidentialite/`} rel="noopener" target="_blank"
        >{t.privacy}</a
      >
    </p>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--navy-900);
    color: rgba(255, 255, 255, 0.68);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    font-size: 0.95rem;
  }
  .ft-particles {
    position: absolute;
    inset: -20% auto auto -6%;
    width: min(30rem, 50%);
    height: 90%;
    z-index: -1;
    -webkit-mask-image: radial-gradient(70% 70% at 30% 30%, #000 0%, transparent 78%);
    mask-image: radial-gradient(70% 70% at 30% 30%, #000 0%, transparent 78%);
  }
  .brand img {
    width: 30px;
    height: auto;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: 2.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    color: #fff;
    margin-bottom: 0.9rem;
  }
  .about p {
    max-width: 34ch;
  }
  .social {
    display: flex;
    gap: 1.1rem;
    margin-top: 1.1rem;
  }
  .col h2 {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1rem;
  }
  .col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  address {
    font-style: normal;
    display: grid;
    gap: 0.6rem;
  }
  .ft a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .ft a:hover {
    color: #ffffff;
  }
  .legal {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .legal a {
    color: rgba(255, 255, 255, 0.6);
  }
  .legal span {
    margin-inline: 0.5rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .legal {
      flex-direction: column;
    }
  }
</style>
