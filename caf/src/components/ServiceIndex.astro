---
import { langFromUrl, servicesFor } from '../i18n';

const SERVICES = servicesFor(langFromUrl(Astro.url));
---

<ul class="svc">
  {
    SERVICES.map((s, i) => (
      <li data-reveal style={`--reveal-i:${i}`}>
        <a href={s.slug}>
          <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="t">{s.title}</span>
          <span class="b">{s.blurb}</span>
          <span class="arw" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .svc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .svc li:first-child {
    grid-column: 1 / -1;
  }
  .svc a {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    height: 100%;
    padding: clamp(1.5rem, 3.5vw, 2.2rem);
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.22s ease;
  }
  .svc a:hover {
    background: var(--blue-050);
  }
  .svc .n {
    position: absolute;
    top: clamp(1rem, 3vw, 1.6rem);
    right: clamp(1.1rem, 3vw, 1.8rem);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3rem);
    line-height: 1;
    color: #d3e8f7;
    transition: color 0.25s ease;
  }
  .svc a:hover .n {
    color: var(--blue);
  }
  .svc .t {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--navy);
    max-width: 24ch;
    transition: color 0.15s ease;
  }
  .svc a:hover .t {
    color: var(--blue-600);
  }
  .svc .b {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 46ch;
  }
  .svc .arw {
    margin-top: 0.4rem;
    color: var(--blue-600);
    font-size: 1.15rem;
    transition: transform 0.22s var(--ease-out);
  }
  .svc a:hover .arw {
    transform: translateX(6px);
  }

  @media (max-width: 680px) {
    .svc {
      grid-template-columns: 1fr;
    }
    .svc li:first-child {
      grid-column: auto;
    }
  }
</style>
