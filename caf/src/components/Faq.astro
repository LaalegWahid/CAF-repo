---
interface QA {
  q: string;
  a: string;
}
interface Props {
  faqs: QA[];
  eyebrow?: string;
  title?: string;
}
const { faqs, eyebrow = 'Questions fréquentes', title = 'Ce que les dirigeants nous demandent' } =
  Astro.props;
---

<section id="faq" class="section">
  <div class="wrap split">
    <div class="intro" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>

    <div class="faq">
      {
        faqs.map((f, i) => (
          <details name="faq" open={i === 0} data-reveal style={`--reveal-i:${i}`}>
            <summary>
              <span class="q">{f.q}</span>
              <span class="ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16">
                  <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .intro h2 {
    margin-top: 0.6rem;
    font-size: var(--step-3);
  }

  .faq {
    border-bottom: 1px solid var(--line);
  }
  details {
    border-top: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.2rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--navy);
    transition: color 0.15s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--blue-600);
  }
  .ico {
    flex: none;
    display: grid;
    place-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    color: var(--blue-600);
    transition: transform 0.28s var(--ease-out), background-color 0.2s ease, border-color 0.2s ease,
      color 0.2s ease;
  }
  details[open] .ico {
    transform: rotate(135deg);
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .answer {
    padding-bottom: 1.3rem;
  }
  details[open] .answer {
    animation: faqIn 0.32s var(--ease-out);
  }
  .answer p {
    max-width: 68ch;
    color: var(--body);
  }
  @keyframes faqIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    details[open] .answer {
      animation: none;
    }
  }

  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
