---
/**
 * Volute de particules reprenant le motif du logo CAF : des points bleus
 * qui deviennent des carrés gris. Accent discret, jamais un bloc central.
 * SVG + animation CSS (opacité / échelle), coupée en reduced-motion.
 */
interface Props {
  variant?: 'hero' | 'ambient';
}
const { variant = 'ambient' } = Astro.props;

const N = variant === 'hero' ? 30 : 18;
const rnd = (seed: number) => {
  const x = Math.sin(seed * 127.1 + 311.7) * 43758.5453;
  return x - Math.floor(x);
};

const parts = Array.from({ length: N }, (_, i) => {
  const t = i / (N - 1);
  const jx = (rnd(i + 1) - 0.5) * 12;
  const jy = (rnd(i + 7) - 0.5) * 14;
  const cx = 8 + t * 84 + jx;
  const cy = 68 - Math.sin(t * Math.PI * 0.9) * 46 + jy;
  const square = t > 0.52 + (rnd(i + 3) - 0.5) * 0.24;
  const size = square ? 1 + rnd(i + 5) * 1.5 : 0.5 + rnd(i + 5) * 0.9;
  const delay = (rnd(i + 9) * 7).toFixed(2);
  const dur = (5 + rnd(i + 11) * 6).toFixed(2);
  return { cx, cy, square, size, delay, dur };
});
---

<div class:list={['particles', `particles--${variant}`]} aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
    {
      parts.map((p) =>
        p.square ? (
          <rect
            x={(p.cx - p.size).toFixed(2)}
            y={(p.cy - p.size).toFixed(2)}
            width={(p.size * 2).toFixed(2)}
            height={(p.size * 2).toFixed(2)}
            rx="0.4"
            class="p sq"
            style={`--d:${p.delay}s;--t:${p.dur}s`}
          />
        ) : (
          <circle
            cx={p.cx.toFixed(2)}
            cy={p.cy.toFixed(2)}
            r={p.size.toFixed(2)}
            class="p dot"
            style={`--d:${p.delay}s;--t:${p.dur}s`}
          />
        )
      )
    }
  </svg>
</div>

<style>
  .particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .particles svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .p {
    transform-box: fill-box;
    transform-origin: center;
    animation: twinkle var(--t, 6s) ease-in-out var(--d, 0s) infinite;
  }
  .dot {
    fill: var(--blue);
  }
  .sq {
    fill: var(--grey);
  }
  .particles--hero .dot {
    opacity: 0.4;
  }
  .particles--hero .sq {
    opacity: 0.28;
  }
  .particles--ambient .dot {
    opacity: 0.32;
  }
  .particles--ambient .sq {
    opacity: 0.22;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.12;
      transform: scale(0.75);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p {
      animation: none;
      opacity: 0.3;
    }
  }
</style>
