---
import { ORG, GOOGLE_FORM_URL } from '../consts';
import { langFromUrl, ui, HOURS_EN } from '../i18n';
import Particles from './Particles.astro';

const lang = langFromUrl(Astro.url);
const t = ui(lang).contact;
const hours = lang === 'en' ? HOURS_EN : ORG.hoursDisplay;
---

<section id="contact" class="section contact">
  <div class="contact-particles"><Particles variant="ambient" /></div>
  <div class="wrap inner">
    <div class="pitch" data-reveal>
      <p class="eyebrow">Contact</p>
      <h2>{t.title}</h2>
      <p class="lede">
        {t.lede}
      </p>

      <ul class="coords">
        <li>
          <span>{t.phone}</span>
          <a href={`tel:${ORG.phone}`}>{ORG.phoneDisplay}</a>
        </li>
        <li>
          <span>{t.email}</span>
          <a href={`mailto:${ORG.email}`}>{ORG.email}</a>
        </li>
        <li>
          <span>{t.office}</span>
          <a href={ORG.mapsUrl} rel="noopener" target="_blank">
            {ORG.street}, {ORG.locality} — {ORG.postalCode}
          </a>
        </li>
        <li>
          <span>{t.hours}</span>
          <div>
            {hours.map(([d, h]) => <p>{d}{lang === 'en' ? ':' : ' :'} {h}</p>)}
          </div>
        </li>
      </ul>
    </div>

    <div class="form-cta" data-reveal style="--reveal-i:1">
      <h3>{t.ctaTitle}</h3>
      <p>{t.ctaText}</p>
      <a class="btn btn--primary" href={GOOGLE_FORM_URL} target="_blank" rel="noopener">{t.ctaButton}</a>
      <p class="form-note">{t.ctaNote}</p>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(34rem 22rem at 100% 100%, var(--blue-050) 0%, transparent 70%),
      var(--bg-tint);
    border-top: 1px solid var(--line);
  }
  .contact-particles {
    position: absolute;
    inset: auto -4% -8% auto;
    width: min(34rem, 55%);
    height: 80%;
    z-index: -1;
    -webkit-mask-image: radial-gradient(70% 70% at 70% 70%, #000 0%, transparent 78%);
    mask-image: radial-gradient(70% 70% at 70% 70%, #000 0%, transparent 78%);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .pitch h2 {
    font-size: var(--step-3);
  }
  .pitch .lede {
    max-width: 42ch;
    margin-bottom: 2rem;
  }
  .coords {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }
  .coords li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .coords span {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .coords a {
    color: var(--teal-ink);
    text-decoration: none;
    font-weight: 500;
  }
  .coords a:hover {
    color: var(--teal);
  }
  .coords p {
    font-size: 0.92rem;
    color: var(--body);
  }

  .form-cta {
    border-top: 2px solid var(--teal-ink);
    padding-top: 1.75rem;
    display: grid;
    gap: 1.1rem;
  }
  .form-cta h3 {
    font-size: var(--step-2);
  }
  .form-cta p {
    max-width: 46ch;
  }
  .form-cta .btn {
    justify-self: start;
    margin-top: 0.3rem;
  }
  .form-note {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .coords li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
