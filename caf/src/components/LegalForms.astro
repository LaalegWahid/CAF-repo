---
import { legalForms } from '../data/sections';
import { legalFormsEn } from '../data/en';
import { langFromUrl, ui } from '../i18n';

const lang = langFromUrl(Astro.url);
const t = ui(lang).legalForms;
const rows = lang === 'en' ? legalFormsEn : legalForms;
---

<section id={lang === 'en' ? 'entity-types' : 'formes'} class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p>{t.intro}</p>
    </div>

    <div class="table-scroll" role="region" aria-label={t.aria} tabindex="0">
      <table>
        <thead>
          <tr>
            {t.cols.map((c) => <th scope="col">{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((f) => (
              <tr>
                <th scope="row">{f.form}</th>
                <td>{f.capital}</td>
                <td>{f.assoc}</td>
                <td>{f.resp}</td>
                <td>{f.best}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="disclaimer">{t.disclaimer}</p>
  </div>
</section>

<style>
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .table-scroll:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 2px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 720px;
    font-size: 0.94rem;
  }
  thead th {
    text-align: left;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--teal);
    padding: 0.95rem 1.1rem;
  }
  tbody th,
  tbody td {
    padding: 1rem 1.1rem;
    border-top: 1px solid var(--line-soft);
    vertical-align: top;
  }
  tbody th {
    text-align: left;
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--teal-ink);
    white-space: nowrap;
  }
  tbody tr:nth-child(even) {
    background: var(--teal-tint-2);
  }
</style>
