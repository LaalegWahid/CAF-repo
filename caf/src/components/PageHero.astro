---
import { CTA_HREF } from '../consts';
import Particles from './Particles.astro';

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  facts?: [string, string][];
}

const {
  eyebrow,
  title,
  lede,
  primary = { label: 'Prendre rendez-vous', href: CTA_HREF },
  secondary,
  facts,
} = Astro.props;
---

<section class="hero">
  <div class="hero-particles"><Particles variant="hero" /></div>
  <div class="wrap">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1 data-reveal style="--reveal-i:1">{title}</h1>
    <p class="lede measure" data-reveal style="--reveal-i:2">{lede}</p>
    <div class="cta" data-reveal style="--reveal-i:3">
      <a class="btn btn--primary" href={primary.href}>{primary.label}</a>
      {secondary && <a class="link-arrow" href={secondary.href}>{secondary.label}</a>}
    </div>

    {
      facts && facts.length > 0 && (
        <dl class="facts" data-reveal style="--reveal-i:4">
          {facts.map(([k, v], i) => (
            <div style={`--reveal-i:${i}`}>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2rem + 8vw, 7rem) clamp(2.5rem, 2rem + 4vw, 4.5rem);
    background: radial-gradient(32rem 22rem at 92% -10%, var(--blue-050) 0%, transparent 65%);
  }
  .hero-particles {
    position: absolute;
    inset: 0 0 auto auto;
    width: min(24rem, 42%);
    height: min(22rem, 70%);
    z-index: -1;
    -webkit-mask-image: radial-gradient(80% 80% at 85% 20%, #000 0%, transparent 72%);
    mask-image: radial-gradient(80% 80% at 85% 20%, #000 0%, transparent 72%);
  }
  h1 {
    font-size: var(--step-5);
    margin-block: 0.5rem 1.4rem;
    max-width: 20ch;
  }
  .lede {
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem 2rem;
    margin-top: 2.4rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    border-top: 1px solid var(--line);
  }
  .facts > div {
    flex: 1 1 12rem;
    padding: 1.5rem 1.75rem 0;
    border-left: 1px solid var(--line);
  }
  .facts > div:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .facts dt {
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--navy);
    font-size: 1.05rem;
  }
  .facts dd {
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .hero-particles {
      width: 55%;
      height: 40%;
      opacity: 0.6;
    }
    .facts > div {
      flex-basis: 45%;
      border-left: 0;
      padding-left: 0;
      padding-right: 1rem;
    }
  }
  @media (max-width: 440px) {
    .facts > div {
      flex-basis: 100%;
    }
  }
</style>
